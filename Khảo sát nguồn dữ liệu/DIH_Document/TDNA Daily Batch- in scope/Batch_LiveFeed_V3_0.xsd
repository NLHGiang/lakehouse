	<xs:complexType name="MetaData">
		<xs:sequence>
			<xs:element name="statistics" type="MetricStatistics" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the value associated to the metric</xs:documentation>
				</xs:annotation>
			</xs:element>
