	<xs:complexType name="Warning">
		<xs:sequence>
			<xs:element name="code" type="xs:string">
				<xs:annotation>
					<xs:documentation>A machine-readable error code from the Amadeus Canned Messages table. It enables the API Consumers code to automatize the handling of this type of error.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="title" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An error title from the Canned Messages table with a 1:1 correspondence to the error code. This may be localized</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="detail" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An easy-to-read explanation specific to this occurrence of the problem. It should give the API user an idea of what went wrong and how to recover from it. Like the title, this field’s value can be localized.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="source" type="ErrorSource" minOccurs="0"/>
			<xs:element name="example" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A sample input to guide the user when resolving this issue (e.g. Dates should be provided using format.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="documentation" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A link to a web page or file with further documentation to help the API user resolve this error.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
