					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="journeys" type="Journey" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="sources" type="SourceReference" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
