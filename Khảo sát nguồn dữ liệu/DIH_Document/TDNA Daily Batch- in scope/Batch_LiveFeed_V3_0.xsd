	<xs:complexType name="Versioning">
		<xs:sequence>
			<xs:element name="links" type="xs:integer">
				<xs:annotation>
					<xs:documentation>specifies the version of link, this version is incremented when links on the profile have changed</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="offset" type="xs:integer">
				<xs:annotation>
					<xs:documentation>Offset is incremented when sources are changed but links are kept, it is reset to 0 when links version is incremented</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="mergeHistory" type="MergeHistory" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This stores the information about a merge event of a cem profile</xs:documentation>
				</xs:annotation>
