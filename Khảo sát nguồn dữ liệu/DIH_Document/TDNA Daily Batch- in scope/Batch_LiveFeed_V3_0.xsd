<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="LiveFeed">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="context">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="trigger" type="xs:string"/>
							<xs:element name="process" type="xs:string"/>
							<xs:element name="timestamp">
								<xs:simpleType>
									<xs:restriction base="xs:dateTime"/>
								</xs:simpleType>
							</xs:element>
							<xs:element name="activities" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="operation" type="xs:string"/>
										<xs:element name="source" type="SourceReference"/>
										<xs:element name="from" type="xs:string" minOccurs="0"/>
										<xs:element name="to" type="xs:string" minOccurs="0"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="dynamicProcesses" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="processName" type="xs:string"/>
										<xs:element name="fromCustomer" type="xs:string" maxOccurs="unbounded"/>
										<xs:element name="toCustomer" type="xs:string" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="customer">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="profile" type="ProfileLiveFeed"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="dictionary" type="Dictionary"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="DDP_context">
		<xs:sequence>
			<xs:element name="trigger">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="source" type="xs:string" minOccurs="0"/>
						<xs:element name="use_case" type="xs:string"/>
						<xs:element name="owner_airline" type="xs:string"/>
						<xs:element name="event_timestamp" type="xs:dateTime"/>
						<xs:element name="event_key" type="xs:string"/>
						<xs:element name="task_key" type="xs:string"/>
						<xs:element name="record_id" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="parameters" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="origin" type="xs:string" minOccurs="0"/>
						<xs:element name="customer_id" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="activities" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>List of activities on the sources of the profile</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="is_trigger" type="xs:boolean"/>
									<xs:element name="operation">
										<xs:annotation>
											<xs:documentation>Operation that occured on the source ADD/UPDATE/DELETE</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="DELETE"/>
												<xs:enumeration value="UPDATE"/>
												<xs:enumeration value="ADD"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="source" type="SourceItem">
										<xs:annotation>
											<xs:documentation>Source element as it is represented in the CIS</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="from" type="xs:string" minOccurs="0"/>
									<xs:element name="to" type="xs:string" minOccurs="0"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="testing_flag" type="xs:string" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ddp_data" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="configuration">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="type" type="xs:string"/>
									<xs:element name="format" type="xs:string"/>
									<xs:element name="method" type="xs:string"/>
									<xs:element name="destination" type="xs:string"/>
									<xs:element name="normalizer_process" type="xs:string"/>
									<xs:element name="transformer_process" type="xs:string"/>
									<xs:element name="task_finalization" type="xs:string" minOccurs="0"/>
									<xs:element name="event_finalization" type="xs:string" minOccurs="0"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="business_content" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="dynamicProcesses" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="processName" type="xs:string"/>
						<xs:element name="fromCustomer" type="xs:string" maxOccurs="unbounded"/>
						<xs:element name="toCustomer" type="xs:string" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DDP_metrics">
		<xs:sequence>
			<xs:element name="name" type="xs:string"/>
			<xs:element name="type" type="xs:string"/>
			<xs:element name="code" type="xs:string"/>
			<xs:element name="value" type="xs:string" minOccurs="0"/>
			<xs:element name="labels" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="label" type="xs:string"/>
						<xs:element name="business_application" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Dictionary">
		<xs:sequence>
			<xs:element name="derivedData" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="DerivedDataSource"/>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="pnrSources" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="PnrSource"/>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="communicationSources" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="CommunicationSource"/>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="ui360EditSources" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="UI360EditSource"/>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="loyaltyProfileSource" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="LoyaltyProfileSource"/>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="ticketingSources" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="TicketSource"/>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="remoteCrmSources" type="RemoteCrmSource" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="alertInstructionSources" type="AlertInstructionSource" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProfileLiveFeed">
		<xs:sequence>
			<xs:element name="id" type="xs:string" minOccurs="0"/>
			<xs:element name="tags" type="AdditionalCategoryTag" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Enables API users to add one or several tags to a profile (e.g. VIP). This functionality gives an additional way to enrich the profile with additional information on which you can act later on (e.g. using business rules).
example:VIP</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="identity" type="IndividualIdentity" minOccurs="0"/>
			<xs:element name="contact" type="Contact" minOccurs="0"/>
			<xs:element name="memberships" type="Membership" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="subscriptions" type="Subscription" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="communications" type="Communication" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="accounts" type="Account" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="products" type="Products" minOccurs="0"/>
			<xs:element name="disruptionInformation" type="DisruptionInformation" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contains the information of disruptions experienced by the passenger</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="metrics" type="Metric" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="touchpoints" type="Touchpoint" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Contains the information related to a specific device.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="links" type="Linkage" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="alertInstructions" type="AlertInstruction" minOccurs="0"/>
			<xs:element name="mergeHistory" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="id" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="version" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BusinessData">
		<xs:sequence>
			<xs:element name="Payment" maxOccurs="unbounded">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
					</xs:annotation>
					<xs:sequence>
						<xs:element name="PAN" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="CVV" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Amount" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="VendorCode" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="CardProvider" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="StartDate" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="EndDate" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="type" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Booking" maxOccurs="unbounded">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
					</xs:annotation>
					<xs:sequence>
						<xs:element name="BookingType" default="" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="BookingRef" default="" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Supplier" maxOccurs="unbounded">
							<xs:complexType>
								<xs:annotation>
									<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
								</xs:annotation>
								<xs:sequence>
									<xs:element name="ID" default="" minOccurs="0">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="xs:string">
													<xs:attribute name="type" type="xs:string"/>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
									<xs:element name="Contact" default="" minOccurs="0">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="xs:string">
													<xs:attribute name="type" type="xs:string"/>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="type" type="xs:string"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="type" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Traveller" maxOccurs="unbounded">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
					</xs:annotation>
					<xs:sequence>
						<xs:element name="Gender" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Name" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="FirstName" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="eTicketNumber" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="fqtv" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="type" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Agency" maxOccurs="unbounded">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
					</xs:annotation>
					<xs:sequence>
						<xs:element name="CompanyName" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="CompanyID" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Account" maxOccurs="unbounded">
							<xs:complexType>
								<xs:annotation>
									<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
								</xs:annotation>
								<xs:sequence>
									<xs:element name="AccountID" minOccurs="0">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="xs:string">
													<xs:attribute name="type" type="xs:string"/>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
									<xs:element name="AccountType" minOccurs="0">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="xs:string">
													<xs:attribute name="type" type="xs:string"/>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="type" type="xs:string"/>
							</xs:complexType>
						</xs:element>
						<xs:element name="Contact" maxOccurs="unbounded">
							<xs:complexType>
								<xs:annotation>
									<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
								</xs:annotation>
								<xs:sequence>
									<xs:element name="Address" minOccurs="0">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="xs:string">
													<xs:attribute name="type" type="xs:string"/>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
									<xs:element name="Email" minOccurs="0">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="xs:string">
													<xs:attribute name="type" type="xs:string"/>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
									<xs:element name="telephone" minOccurs="0">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="xs:string">
													<xs:attribute name="type" type="xs:string"/>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
								<xs:attribute name="type" type="xs:string"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="type" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Notification" maxOccurs="unbounded">
				<xs:complexType>
					<xs:annotation>
						<xs:documentation>Parameters of the Virtual Card to be generated</xs:documentation>
					</xs:annotation>
					<xs:sequence>
						<xs:element name="Type" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
						<xs:element name="Content" minOccurs="0">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name="type" type="xs:string"/>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="type" type="xs:string"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="version" type="xs:string" default="1.0"/>
	</xs:complexType>
	<xs:complexType name="Acceptance">
		<xs:sequence>
			<xs:element name="status" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="STANDBY"/>
						<xs:enumeration value="REJECTED"/>
						<xs:enumeration value="NOT_ACCEPTED"/>
						<xs:enumeration value="ACCEPTED"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="at" type="xs:string" minOccurs="0"/>
			<xs:element name="via" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="OTHER"/>
						<xs:enumeration value="AIRLINE_WEBSITE"/>
						<xs:enumeration value="SMS_APPLICATION"/>
						<xs:enumeration value="MOBILE_PHONE_APPLICATION"/>
						<xs:enumeration value="KIOSK"/>
						<xs:enumeration value="ALTEA_DEPARTURE_CONTROL_SYSTEM"/>
						<xs:enumeration value="EXTERNAL_DEPARTURE_CONTROL_SYSTEM"/>
						<xs:enumeration value="AMADEUS_TERMINAL_EMULATOR"/>
						<xs:enumeration value="AUTO_CHECK_IN"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="originator" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ELECTRONIC_SELLING_SYSTEM"/>
						<xs:enumeration value="DIRECT_CONSUMER"/>
						<xs:enumeration value="SELF_SERVICE_MACHINE"/>
						<xs:enumeration value="CHECK_IN_AGENT"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="position" type="xs:integer" minOccurs="0"/>
			<xs:element name="airline" type="CorporationName" minOccurs="0"/>
			<xs:element name="cancellationDetails" type="cancellationDetails" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Account">
		<xs:sequence>
