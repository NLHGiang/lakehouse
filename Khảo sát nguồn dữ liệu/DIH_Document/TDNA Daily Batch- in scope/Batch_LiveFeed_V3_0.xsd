	<xs:complexType name="Subscription">
		<xs:sequence>
			<xs:element name="subscriptionType">
				<xs:annotation>
					<xs:documentation>Subscription type </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="OPERATIONAL"/>
						<xs:enumeration value="PROMOTIONS"/>
						<xs:enumeration value="OTHER"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="status" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Subscription status (e.g. ACTIVE).</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="ACTIVE"/>
						<xs:enumeration value="CANCELLED"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="actors" type="Actor" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="startAt" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date when the subscription request has been received using format (e.g. 2017-02-10T20:40:00+02:00)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="endAt" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date when the subscription ends using format (e.g. 2017-02-10T20:40:00+02:00)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cancellation" type="Cancellation" minOccurs="0"/>
			<xs:element name="via" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Describes the form of subscription (e.g Social media, Referral Programs, Contest, etc)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="sources" type="SourceReference" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="Tag">
		<xs:restriction base="xs:string">
			<xs:enumeration value="DECLARED"/>
			<xs:enumeration value="INFERRED"/>
			<xs:enumeration value="INTEREST"/>
			<xs:enumeration value="PREFERRED"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="Tax">
		<xs:sequence>
			<xs:element name="currency" type="xs:string" minOccurs="0"/>
			<xs:element name="value" type="xs:string" minOccurs="0"/>
			<xs:element name="natureCode" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
          Description:
            Tax code
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="indicator" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
          Description:
            Tax category
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="isExempted" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
          Description:
            If true the tax is exempted
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="rate" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
          Description:
            Tax rate
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="countryCode" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
          Description:
            Tax iso country code
          </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TicketSource">
		<xs:sequence>
			<xs:element name="receivedAt" type="xs:string" minOccurs="0"/>
			<xs:element name="lastModifiedAt" type="xs:string" minOccurs="0"/>
			<xs:element name="link" type="xs:string" minOccurs="0"/>
			<xs:element name="id" type="xs:string" minOccurs="0"/>
			<xs:element name="sourceType" type="SourceType_TicketSource" minOccurs="0"/>
			<xs:element name="ticket" type="ContractIdentifier" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
          Description:
            General information about contracts associated to the customer's profile.
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="envelope" type="xs:integer" minOccurs="0">
				<xs:annotation>
					<xs:documentation>

          Example:
            10
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="creatorPointOfSale" type="PointOfSale" minOccurs="0"/>
			<xs:element name="version" type="xs:integer" minOccurs="0"/>
			<xs:element name="status" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Tier">
		<xs:sequence>
			<xs:element name="name" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the name or description of the tier such as Gold, Silver or Platinum.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="code" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A code representing the status of the member (e.g. for Gold).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="startDate" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The date at which the member reached the tier level using the format (e.g. 2016-10-20).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="endDate" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The date at which the member is not of the actual tier level any more (e.g.the member has moved to another tier level). The date must be provided using the format (e.g. 2017-10-20)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="priorityCode" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Airline priority code used to synchronize with external systems</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="customerValue" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies the value of the customer. In case of corporate flyer, it is called Corporate Airline Customer Value and consists of 4 digits.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="milesBalances" type="MilesBalance" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Balance of the member (e.g award, total)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Touchpoint">
		<xs:sequence>
			<xs:element name="type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Touchpoint type. The Device object can be different depending on the touchpoint type.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="WEBSITE"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="device" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contains the information related to a specific device.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="id" type="xs:string" minOccurs="0"/>
						<xs:element name="type" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="SMARTPHONE"/>
									<xs:enumeration value="TABLET"/>
									<xs:enumeration value="DESKTOP"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="operatingSystem" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="iOS"/>
									<xs:enumeration value="Android"/>
									<xs:enumeration value="Windows"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="apiKeys" type="ApiKey" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Dedicated API keys used to uniquely identify a given mobile device to which notifications may be sent to</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="connectedAt" type="xs:string" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Date time of each of the connections</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="applications" type="Application" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The calling application who has been installed on this given touchpoint device</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TrackedBooking">
		<xs:sequence>
			<xs:element name="identity" type="IndividualIdentity" minOccurs="0"/>
			<xs:element name="trackedReservation" type="Reservation" minOccurs="0"/>
			<xs:element name="trackedTicket" type="ContractIdentifier" minOccurs="0"/>
			<xs:element name="relationships" type="Relationship" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="roles" type="Role" minOccurs="0" maxOccurs="unbounded"/>
