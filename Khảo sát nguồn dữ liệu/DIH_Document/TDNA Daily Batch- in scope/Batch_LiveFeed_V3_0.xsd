	<xs:complexType name="AirInformativeService">
		<xs:sequence>
			<xs:element name="tattoo" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the unique identifier of the element within the PNR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="typeCode">
				<xs:annotation>
					<xs:documentation>Code associated to the type of air informative element (e.g. SK for Special Keyword).</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="SK"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="code" type="xs:string">
				<xs:annotation>
					<xs:documentation>Service code (e.g. IMPT for Important).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="providerCode" type="xs:string">
				<xs:annotation>
					<xs:documentation>Provides the company or organization fulfilling the service (e.g. 6X). Please note that IATA code context is used.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="status" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provide information concerning the status element. There are several standard codes supported (e.g. HK for confirmed). For more details please refer to Amadeus Reservation system documentation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="quantity" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the number in party associated to the element</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="description" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides a description of the informative element (e.g. Special Traveller).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="locator" type="Locator" minOccurs="0"/>
			<xs:element name="createdAt" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Date time at which the element was created in Amadeus system using the format (e.g. 2017-01-01T05:20:54:00).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="relatedProducts" type="ResourceReference" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="relatedElements" type="ElementRelationship" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Technical reference to an object functionally related to the one using this element. The link can be made using any attribute of the remote object, for instance its tattoo. The understanding of where such an object should be looked up in is beyond the scope of this object, and is defined on a case-by-case basis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="sources" type="SourceReference" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="additionalDetails" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
