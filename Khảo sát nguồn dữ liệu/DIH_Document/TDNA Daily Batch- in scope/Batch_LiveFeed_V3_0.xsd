	<xs:complexType name="AlertAcknowledgement">
		<xs:sequence>
			<xs:element name="alertId" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Unique identifier of the CEM Alert</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="message" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Content of the alert message</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="evaluatedAt" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date and time when the alert has been evaluated by the CEM system using format (e.g. 2017-02-10T20:40:00Z)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="alertRuleId" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Unique identifier of the Alert Rule that initiated the alert</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="alertRuleName" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Name of the alert ruleas stored in CEM</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="category" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Category of the Alert</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="NOT_OPERATIONAL"/>
						<xs:enumeration value="OPERATIONAL"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="weight" type="xs:integer" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the weight of the Alert</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="priority" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the priority of the Alert</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="LOW"/>
						<xs:enumeration value="MEDIUM"/>
						<xs:enumeration value="HIGH"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="computedRanking" type="xs:integer" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Specifies the rank of the alert based on its weight, priority and category, as calculated by the CEM system</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="evaluationSources" type="SourceReference" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Profile sources that were used to evaluate the alert</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="deliveryStatus" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Status of the delivery (e.g. DELIVERED)</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="NOT_DELIVERED"/>
						<xs:enumeration value="DELIVERED"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="closeOption" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates if the agent wishes the alert to stay active or to be deactivated (e.g: CLOSE).</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="CLOSE"/>
						<xs:enumeration value="OPEN"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="channel" type="Channel" minOccurs="0"/>
			<xs:element name="structuredFeedback" type="Feedback" minOccurs="0"/>
			<xs:element name="freetextFeedback" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>content of the feedback. Can be either freetext or coming from a structured feedback</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="flightIdentifier" type="FlightIdentifier" minOccurs="0"/>
			<xs:element name="departure" type="EndPoint" minOccurs="0"/>
			<xs:element name="arrival" type="EndPoint" minOccurs="0"/>
			<xs:element name="relatedRecord" type="SourceItem" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="AlertCategory">
		<xs:restriction base="xs:string">
			<xs:enumeration value="OPERATIONAL"/>
			<xs:enumeration value="NOT_OPERATIONAL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="AlertInstruction">
		<xs:sequence>
			<xs:element name="id" type="Locator">
				<xs:annotation>
					<xs:documentation>Identifier of the Alert Instruction</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="alertInstructionName" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Name of the alert instruction.
		Example: Alert for new customers on 6X flights
      </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="message" type="xs:string">
				<xs:annotation>
					<xs:documentation>
			Content of the alert message
			Example: Wish the customer a warm welcome
      </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="category" type="AlertCategory"/>
			<xs:element name="weight" type="xs:integer">
				<xs:annotation>
					<xs:documentation>
			Specifies the weight of the Alert
			Minimum 0, maximum 99
      </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="priority">
				<xs:simpleType>
					<xs:restriction base="AlertPriority">
						<xs:enumeration value="HIGH"/>
						<xs:enumeration value="MEDIUM"/>
						<xs:enumeration value="LOW"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="flightTattoos" type="xs:integer" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
			Tattoo of the flight the alert instruction applies to. Applies to all flights if not present
      </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="channels" type="Channel" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
			Touchpoints for which the alert will be displayed
      </xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- Not aligned with the yml but changed needed to be aligned with what is sent to JL in the livefeed-->
			<xs:element name="sources" type="SourceReference" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AlertInstructionSource">
		<xs:sequence>
			<xs:element name="id" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Source identifier</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="sourceType" type="SourceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Provides the type of the source described (e.g. PnrSource)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="link" type="xs:string" minOccurs="0">
				<xs:annotation>
