				<xs:annotation>
					<xs:documentation>A sample input to guide the user when resolving this issue (e.g. Dates should be provided using format.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="documentation" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A link to a web page or file with further documentation to help the API user resolve this error.</xs:documentation>
