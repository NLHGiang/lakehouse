				</xs:annotation>
			</xs:element>
			<xs:element name="receivedAt" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date and time at which the feed has been received by the system using format “yyyy-MM-ddTHH:mm:ssZ” (e.g. 2017-02-10T20:40:00+02:00)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="lastModifiedAt" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date and time at which the feed has been last updated by the system using format "yyyy-MM-ddTHH:mm:ssZ" (e.g. 2017-02-10T20:40:00Z)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="locator" type="Locator" minOccurs="0"/>
			<xs:element name="status" type="xs:string" minOccurs="0"/>
